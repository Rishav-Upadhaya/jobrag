# ── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_DB=ragdb

# ── LlamaCloud (vector index + embeddings) ────────────────────────────────────
LLAMA_CLOUD_API_KEY=
LLAMA_CLOUD_INDEX_NAME=leapfrog-jobs
LLAMA_CLOUD_PROJECT_NAME=Default
LLAMA_CLOUD_TOP_K=40

# ── LLM provider ──────────────────────────────────────────────────────────────
LLM_PROVIDER=
LLM_SYNTHESIZER_MODEL=
LLM_CLASSIFIER_MODEL=
LLM_JUDGE_MODEL=
LLM_TEMPERATURE=

GOOGLE_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=

# ── Jina reranker ─────────────────────────────────────────────────────────────
JINA_API_KEY=
JINA_RERANKER_MODEL=jina-reranker-v2-base-multilingual
JINA_RERANK_THRESHOLD=0.3

# ── Retrieval knobs ───────────────────────────────────────────────────────────
TOP_K_KEYWORD=40
TOP_K_RERANK=10

# ── Judge ─────────────────────────────────────────────────────────────────────
JUDGE_PASS_THRESHOLD=0.7
JUDGE_MAX_RETRIES=2

# ── LangSmith tracing ─────────────────────────────────────────────────────────
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
